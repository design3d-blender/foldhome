<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">FoldHome</string>

    <!-- Shows the wallpaper so the brief moment before the real launcher appears isn't a black flash. -->
    <style name="ProxyTheme" parent="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
